<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BiliLocal.Desktop.MainWindow" Title="BiliLocal · 视频下载工作台" Width="1240" Height="850" MinWidth="920" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Window.Styles>
  <Style Selector="Button"><Setter Property="Padding" Value="12,7"/></Style>
  <Style Selector="TextBox"><Setter Property="Padding" Value="10,7"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,5"/></Style>
  <Style Selector="Button.nav"><Setter Property="Padding" Value="8,12"/></Style>
 </Window.Styles>
 <Grid ColumnDefinitions="Auto,*">
  <Border Name="Sidebar" Width="{Binding SidebarWidth}" Background="White" BorderBrush="#E8EBF2" BorderThickness="0,0,1,0" Padding="8,14">
   <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18"><TextBlock IsVisible="{Binding SidebarExpanded}" FontSize="23" FontWeight="Bold" Foreground="#EB7398" Text="BiliLocal" Margin="8,0" VerticalAlignment="Center"/><Button Name="SidebarToggle" Grid.Column="1" Content="☰" Width="36" Padding="0,7" Background="Transparent" Click="ToggleSidebarClick" ToolTip.Tip="展开 / 收起侧栏" AutomationProperties.Name="展开或收起侧栏"/></Grid>
    <StackPanel DockPanel.Dock="Bottom" Spacing="8"><TextBlock IsVisible="{Binding SidebarExpanded}" Text="{Binding Account}" TextTrimming="CharacterEllipsis" Margin="10,0" ToolTip.Tip="{Binding Account}"/><Button Classes="nav" Click="LoginClick" ToolTip.Tip="{Binding Account}"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="♙" Width="16"/><TextBlock IsVisible="{Binding SidebarExpanded}" Text="登录 / 账号设置"/></StackPanel></Button></StackPanel>
    <StackPanel Spacing="4"><Button Classes="nav" Click="LibraryClick" ToolTip.Tip="视频资料库"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="▦" Width="16"/><TextBlock IsVisible="{Binding SidebarExpanded}" Text="视频资料库"/></StackPanel></Button><Button Classes="nav" Click="QueueClick" ToolTip.Tip="下载队列"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="↓" Width="16"/><TextBlock IsVisible="{Binding SidebarExpanded}" Text="下载队列"/></StackPanel></Button><Button Classes="nav" Click="OpenFolderClick" ToolTip.Tip="打开下载目录"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="↗" Width="16"/><TextBlock IsVisible="{Binding SidebarExpanded}" Text="打开下载目录"/></StackPanel></Button><Button Classes="nav" Click="DownloadDirectoryClick" ToolTip.Tip="设置下载目录"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="⚙" Width="16"/><TextBlock IsVisible="{Binding SidebarExpanded}" Text="设置下载目录"/></StackPanel></Button></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="16,14,16,10">
   <Grid IsVisible="{Binding Library}" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <Border Background="White" CornerRadius="8" BorderBrush="#E5E9F1" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
     <Grid ColumnDefinitions="Auto,*,Auto,Auto"><TextBlock Text="UP 主" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Name="UpInput" Grid.Column="1" Text="{Binding Up}" Watermark="UID 或空间链接" KeyDown="SearchKeyDown"/><Button Grid.Column="2" Classes="primary" Content="获取视频" Margin="8,0" Click="SearchClick" IsEnabled="{Binding Ready}"/><Button Grid.Column="3" Content="批量添加" Click="DirectClick" Background="Transparent" Foreground="#D8678F"/></Grid>
    </Border>
    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,6">
     <Grid ColumnDefinitions="*,180,Auto,110" IsEnabled="{Binding Ready}"><TextBlock Text="{Binding Collection}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/><TextBox Name="KeywordInput" Grid.Column="1" Text="{Binding Keyword, Mode=TwoWay}" Watermark="标题关键词 / BV号" ToolTip.Tip="输入后自动搜索，也可按 Enter 或点击搜索" TextChanged="KeywordChanged" KeyDown="SearchKeyDown"/><Button Name="KeywordSearchButton" Grid.Column="2" Content="搜索" Click="KeywordSearchClick" Margin="6,0,0,0"/><ComboBox Name="SortBox" Grid.Column="3" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="SortChanged"><ComboBoxItem Content="最新发布"/><ComboBoxItem Content="最多播放"/><ComboBoxItem Content="最多收藏"/></ComboBox></Grid>
     <Grid ColumnDefinitions="Auto,140,Auto,*,Auto" IsEnabled="{Binding Ready}">
      <TextBlock Text="视频类型" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox Name="ChargeBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="LibraryFilterChanged"><ComboBoxItem Content="全部视频"/><ComboBoxItem Content="仅充电视频"/><ComboBoxItem Content="排除充电视频"/></ComboBox>
      <TextBlock Grid.Column="2" Text="合集和系列" VerticalAlignment="Center" Margin="12,0,8,0"/>
      <ComboBox Name="CollectionBox" Grid.Column="3" ItemsSource="{Binding Collections}" SelectedIndex="0" HorizontalAlignment="Stretch" MaxDropDownHeight="400" SelectionChanged="LibraryFilterChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="560"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Button Grid.Column="4" Content="↻" ToolTip.Tip="刷新合集和系列" AutomationProperties.Name="刷新合集和系列" Click="RefreshCollectionsClick" Margin="8,0,0,0" Padding="10,6"/>
     </Grid>
     <Grid ColumnDefinitions="Auto,Auto,Auto,*"><Button Content="全选本页" Click="SelectPageClick" Padding="10,6"/><Button Grid.Column="1" Content="清空选择" Click="ClearClick" Margin="8,0" Padding="10,6"/><TextBlock Grid.Column="2" Text="{Binding Selection}" VerticalAlignment="Center" Foreground="#D76D94"/><TextBlock Grid.Column="3" Classes="muted" Text="支持跨页选择" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </StackPanel>
    <Grid Grid.Row="2" Name="VideoListArea">
     <TextBlock Name="EmptyText" Text="你的视频收藏，从这里开始。&#10;获取 UP 主的视频列表，或批量粘贴 BV 号。" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="28"/>
     <ScrollViewer><ItemsControl ItemsSource="{Binding Videos}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="White" BorderBrush="#E6EAF1" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
       <Grid ColumnDefinitions="Auto,112,*,Auto"><CheckBox IsChecked="{Binding Video.Selected}" VerticalAlignment="Center" Margin="0,0,8,0"/><Border Grid.Column="1" CornerRadius="5" Background="#F2EAF2" ClipToBounds="True" Height="63"><Image Source="{Binding Cover}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5" Margin="12,0"><TextBlock Text="{Binding Video.Title}" TextWrapping="Wrap" MaxHeight="38" FontWeight="SemiBold"/><TextBlock Classes="muted" Text="{Binding Video.Meta}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="选分 P" Tag="{Binding Video}" Click="SelectPartsClick" Padding="9" ToolTip.Tip="选择一个或多个分 P 下载"/><Button Content="↗" Tag="{Binding Video.Bvid}" Click="OpenVideoClick" Padding="9"/></StackPanel></Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,4"><Button Name="PreviousButton" Content="← 上一页" Click="PreviousClick" IsEnabled="False" Padding="10,5"/><TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Classes="muted"/><Button Name="NextButton" Content="下一页 →" Click="NextClick" IsEnabled="False" Padding="10,5"/></StackPanel>
    <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="10,8" BorderBrush="#E5E9F1" BorderThickness="1">
     <Grid ColumnDefinitions="*,140,140,Auto,Auto" VerticalAlignment="Center"><Button Content="保存目录 ⚙" Click="DownloadDirectoryClick" ToolTip.Tip="{Binding DownloadDirectory}" Background="Transparent" Foreground="#69788F" HorizontalAlignment="Left"/><ComboBox Name="QualityBox" Grid.Column="1" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="最高可用画质"/><ComboBoxItem Content="最高 4K"/><ComboBoxItem Content="最高 1080P"/><ComboBoxItem Content="最高 720P"/><ComboBoxItem Content="最高 480P"/><ComboBoxItem Content="最高 360P"/></ComboBox><ComboBox Name="ModeBox" Grid.Column="2" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="ModeChanged"><ComboBoxItem Content="视频 · MP4"/><ComboBoxItem Content="音频 · MP3"/></ComboBox><ComboBox Grid.Column="3" Name="PartsModeBox" SelectedIndex="0" Margin="0,0,8,0" ToolTip.Tip="选择下载范围"><ComboBoxItem Content="全部分 P"/><ComboBoxItem Content="仅首个分 P"/><ComboBoxItem Content="选择分 P…"/></ComboBox><Button Grid.Column="4" Classes="primary" Name="DownloadButton" Content="加入队列 ↓" Click="DownloadClick" IsEnabled="{Binding Ready}"/></Grid>
    </Border>
   </Grid>
   <Grid IsVisible="{Binding Queue}" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock Text="下载队列" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="打开下载目录 ↗" Click="OpenFolderClick" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10"><StackPanel Spacing="10"><Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"><Button Name="StartAllButton" Content="▶ 全部开始" Classes="primary" Click="StartAllClick" IsEnabled="{Binding CanStartJobs}"/><Button Name="PauseAllButton" Grid.Column="1" Content="Ⅱ 全部暂停" Click="PauseAllClick" IsEnabled="{Binding CanPauseJobs}" Margin="8,0"/><Button Name="DeleteAllButton" Grid.Column="2" Content="全部删除" Click="DeleteAllClick" IsEnabled="{Binding HasJobs}" Foreground="#C75470" ToolTip.Tip="删除全部任务记录，保留已下载文件"/><TextBlock Grid.Column="4" Text="并行任务" VerticalAlignment="Center" Margin="8,0"/><ComboBox Name="ConcurrencyBox" Grid.Column="5" Width="78" SelectionChanged="ConcurrencyChanged" ToolTip.Tip="同时下载 1–6 个视频；降低并行数后，当前下载继续完成"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/></ComboBox></Grid><TextBlock Text="{Binding QueueSummary}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
    <ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding Jobs}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="White" BorderBrush="#E6EAF1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto,Auto,Auto"><TextBlock Text="{Binding Job.DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0"><Button Content="暂停" Tag="{Binding Job.Id}" Click="PauseJobClick" IsVisible="{Binding Job.CanPause}" Padding="10,6"/><Button Content="{Binding Job.StartLabel}" Tag="{Binding Job.Id}" Click="StartJobClick" IsVisible="{Binding Job.CanStart}" Padding="10,6"/></StackPanel><Button Grid.Column="2" Content="删除" Tag="{Binding Job.Id}" Click="DeleteJobClick" Padding="10,6" Foreground="#C75470" ToolTip.Tip="删除任务记录，保留已下载文件"/><Button Grid.Column="3" Content="文件 ↗" Tag="{Binding Job.Id}" Click="JobFolderClick" Padding="10,6" Margin="8,0,0,0"/></Grid><TextBlock Classes="muted" Text="{Binding Job.Info}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job.Info}"/><ProgressBar Value="{Binding Job.Progress}" Minimum="0" Maximum="100" Height="5" Foreground="#ED85A5"/><TextBlock Text="{Binding Job.ProgressLabel}" Foreground="#D37497" FontSize="11"/><TextBlock Text="{Binding Job.Error}" IsVisible="{Binding Job.HasError}" Foreground="#C75470" TextWrapping="Wrap"/></StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid>
   <StackPanel Grid.Row="1" Spacing="3" Margin="0,5,0,0"><ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" Foreground="#69788F" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="取消加载" Click="CancelSearchClick" IsVisible="{Binding Busy}" Padding="8,4"/></Grid></StackPanel>
  </Grid>
 </Grid>
</Window>
