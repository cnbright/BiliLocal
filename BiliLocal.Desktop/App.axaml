<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BiliLocal.Desktop.App" RequestedThemeVariant="Light">
 <Application.Styles>
  <FluentTheme />
  <Style Selector="Window"><Setter Property="Icon" Value="avares://BiliLocal.Desktop/Assets/BiliLocal.ico"/></Style>
  <Style Selector="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, sans-serif"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F7F8FC"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#EE739A"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Padding" Value="18,15"/></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,10"/></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="MinHeight" Value="38"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8C95A5"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#263148"/></Style>
 </Application.Styles>
</Application>
